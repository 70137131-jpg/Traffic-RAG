# Required
GOOGLE_API_KEY=your_google_api_key_here

# Database (Postgres + pgvector). Local default shown; use your Neon/Supabase
# connection string in production.
DATABASE_URL=postgresql:///traffic_rag_dev
# DB_POOL_MAX=8

# Embeddings: 'local' (HuggingFace, 384-dim) or 'google' (text-embedding-004, 768-dim).
# When switching provider, set EMBEDDING_DIM to match and re-ingest documents.
# EMBEDDING_PROVIDER=local
# EMBEDDING_DIM=384
# RERANK_ENABLED=true

# Serving
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Models (optional overrides)
# LLM_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval tunables (optional overrides)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_ARM_TOP_K=10
# HYBRID_CANDIDATES=10
# RERANK_TOP_K=3
# RRF_K=60

# LLM reliability (optional overrides)
# LLM_TIMEOUT=30
# LLM_MAX_ATTEMPTS=3

# Storage
# CHROMA_DIR=chroma_db
# DEFAULT_DOCUMENT=traffic_laws.md

# Models load from the local HuggingFace cache without network checks when both
# are already cached (auto-detected). Force it explicitly (e.g. baked into a
# container image) with:
# HF_HUB_OFFLINE=1
