# Required
GOOGLE_API_KEY=your_google_api_key_here

# Database (Postgres + pgvector). Local default shown; use your Neon/Supabase
# connection string in production.
DATABASE_URL=postgresql:///traffic_rag_dev
# DB_POOL_MAX=8

# Embeddings: 'local' (HuggingFace, 384-dim) or 'google' (text-embedding-004, 768-dim).
# When switching provider, set EMBEDDING_DIM to match and re-ingest documents.
# EMBEDDING_PROVIDER=local
# EMBEDDING_DIM=384
# RERANK_ENABLED=true
# Torch device for local models: ""(auto)/cpu/cuda/mps. Use 'cpu' under gunicorn
# on macOS (forking + Metal/MPS crashes). Linux is CPU-only, so auto == cpu.
# EMBEDDING_DEVICE=cpu

# Serving
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Models (optional overrides)
# LLM_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval tunables (optional overrides)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_ARM_TOP_K=10
# HYBRID_CANDIDATES=10
# RERANK_TOP_K=3
# RRF_K=60

# LLM reliability (optional overrides)
# LLM_TIMEOUT=30
# LLM_MAX_ATTEMPTS=3

# Storage
# DEFAULT_DOCUMENT=traffic_laws.md

# Models load from the local HuggingFace cache without network checks when both
# are already cached (auto-detected). Force it explicitly (e.g. baked into a
# container image) with:
# HF_HUB_OFFLINE=1

# --- Phase 2 hardening (safe defaults; tighten in production) ---
# Trusted reverse proxies in front of the app (Cloud Run/PaaS = 1). 0 = don't
# trust X-Forwarded-* (correct for a directly-exposed dev server).
# TRUSTED_PROXY_COUNT=1
# Send HSTS (only behind HTTPS).
# ENABLE_HSTS=1
# Optional API-key gate for the JSON API (/ask, /upload, /documents). Leave unset
# to keep the browser UI open and rely on platform SSO/IAP instead.
# APP_API_KEY=change-me
# CORS: comma-separated allowed origins. Empty => same-origin only.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# Rate limits (per client IP). Set RATE_LIMIT_STORAGE_URI to Redis for multi-instance.
# RATE_LIMIT_DEFAULT=200 per hour
# RATE_LIMIT_ASK=30 per minute
# RATE_LIMIT_UPLOAD=10 per minute
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379
# Gunicorn worker count (also read by the Docker CMD).
# WEB_CONCURRENCY=2
